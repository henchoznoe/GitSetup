#!/bin/bash
# Hook generated by GitSetup
# Automatically adjust Git user email based on the remote host

remote_url=$(git remote get-url origin 2>/dev/null)
if [ -z "$remote_url" ]; then exit 0; fi

case "$remote_url" in
  *"${GITHUB_HOST}"*)
    git config user.email "${GITHUB_EMAIL}"
    echo "🔄 [Hook] Email set to ${GITHUB_EMAIL} (GitHub)"
    ;;
  *"${GITLAB_HOST}"*)
    git config user.email "${GITLAB_EMAIL}"
    echo "🔄 [Hook] Email set to ${GITLAB_EMAIL} (GitLab)"
    ;;
  *)
    git config user.email "${GIT_USER_EMAIL_DEFAULT}"
    echo "🔄 [Hook] Email set to ${GIT_USER_EMAIL_DEFAULT} (Default)"
    ;;
esac
