# --- GitHub ---
Host ${GITHUB_HOST}
    HostName ${GITHUB_HOST}
    User git
    IdentityFile ${SSH_DIR}/${GITHUB_SSH_KEY_FILE}
    IdentitiesOnly yes

# --- GitLab ---
Host ${GITLAB_HOST}
    HostName ${GITLAB_HOST}
    User git
    IdentityFile ${SSH_DIR}/${GITLAB_SSH_KEY_FILE}
    IdentitiesOnly yes
