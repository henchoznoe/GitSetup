# ==============================================================================
# File:        .env.example
# Description: Configuration template. Copy this to .env and edit.
# Date:        2026-04-27
# ==============================================================================

# --- General Identity ---
GIT_USER_NAME="John Doe"
GIT_USER_EMAIL_DEFAULT="john.doe@example.com"

# --- Dynamic Profiles (Format: "host:email,host:email") ---
# Add as many as you need. The script will generate the hook based on this list.
GIT_PROFILES="github.com:john.doe@example.com,self.hosted.gitlab.com:john.gitlab@example.com"

# --- GPG Signing ---
# Set to "true" to enable GPG signing of commits
ENABLE_GPG_SIGNING="false"
# Path to GPG program (gpg, gpg2, /usr/local/bin/gpg, etc.)
GPG_PROGRAM="gpg"

# --- Editor Preferences ---
# Examples: code, nano, vim, vi
GIT_CORE_EDITOR="nano"

# --- Commit Convention ---
# Set to "true" to enforce Conventional Commits (feat: ..., fix: ...)
ENABLE_CONVENTIONAL_COMMITS="true"
