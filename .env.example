# ==============================================================================
# File:        .env.example
# Description: Configuration template. Copy this to .env and edit.
# Date:        2025-12-21
# ==============================================================================

# --- 👤 General Identity ---
GIT_USER_NAME="John Doe"
GIT_USER_EMAIL_DEFAULT="john.doe@example.com"

# --- 🐙 GitHub Configuration ---
GITHUB_HOST="github.com"
GITHUB_EMAIL="john.github@example.com"
# Leave empty if you don't want to generate a specific key for GitHub
GITHUB_SSH_KEY_FILE="id_ed25519_github"

# --- 🦊 GitLab Configuration ---
# Change host if you use a self-hosted instance
GITLAB_HOST="gitlab.com"
GITLAB_EMAIL="john.gitlab@company.com"
GITLAB_SSH_KEY_FILE="id_ed25519_gitlab"

# --- 🔐 Security (GPG) ---
# Set to "true" to enable GPG signing setup
ENABLE_GPG_SIGNING="true"
# Optional: Path to the GPG program (auto-detected if empty)
GPG_PROGRAM=""

# --- ⚙️ Editor Preferences ---
# Examples: code, nano, vim, vi
GIT_CORE_EDITOR="code --wait"
