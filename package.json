{
  "name": "git-setup",
  "version": "1.9.2",
  "description": "Automated & Non-Destructive Git Environment Setup. Manage multiple identities & SSH keys seamlessly on macOS.",
  "homepage": "https://github.com/henchoznoe/GitSetup",
  "bugs": {
    "url": "https://github.com/henchoznoe/GitSetup/issues",
    "email": "henchoznoe@gmail.com"
  },
  "license": "MIT",
  "author": "Noé Henchoz <henchoznoe@gmail.com> (https://henchoznoe.ch/)",
  "type": "module",
  "bin": {
    "git-setup": "./dist/git-setup.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "darwin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henchoznoe/GitSetup.git"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsx scripts/build.ts",
    "start": "tsx src/bin/git-setup.ts",
    "start:dry": "tsx src/bin/git-setup.ts --dry-run",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check --write .",
    "check:com": "biome check --write . && knip && vitest run && tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "lint-staged": "^17.4.1",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
