#!/bin/bash
# ==============================================================================
# File:        bin/git-setup
# Description: Main entry point for the Git Setup CLI.
# Author:      Noé Henchoz <henchoznoe@gmail.com>
# License:     MIT
# ==============================================================================

# Resolve paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
ENV_FILE="$PROJECT_ROOT/.env"

# Source libraries
source "$PROJECT_ROOT/lib/logger.sh"
source "$PROJECT_ROOT/lib/utils.sh"
source "$PROJECT_ROOT/lib/config.sh"

main() {
    log_info "🚀 Starting GitSetup..."

    # 1. Load Configuration
    if ! config_load "$ENV_FILE"; then
        exit 1
    fi

    # 2. Validate Configuration
    config_validate

    # 3. System Checks (Example usage)
    if utils_is_macos; then
        log_info "Detected OS: macOS"
    else
        log_warning "This script is optimized for macOS. Some features might differ on Linux."
    fi

    # Temporary debug to show it works
    log_info "Welcome, $GIT_USER_NAME!"
    
    log_success "Setup ready to proceed."
}

main "$@"
