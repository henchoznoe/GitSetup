#!/bin/bash
# ==============================================================================
# File:        bin/git-setup
# Description: Main entry point for the Git Setup CLI.
# Author:      Noé Henchoz <henchoznoe@gmail.com>
# Date:        2025-12-21
# License:     MIT
# ==============================================================================

# Resolve paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
ENV_FILE="$PROJECT_ROOT/.env"
SSH_DIR="$HOME/.ssh"

# Source libraries
source "$PROJECT_ROOT/lib/logger.sh"
source "$PROJECT_ROOT/lib/utils.sh"
source "$PROJECT_ROOT/lib/config.sh"
source "$PROJECT_ROOT/lib/ssh_manager.sh"
source "$PROJECT_ROOT/lib/git_manager.sh"

# Parse command line arguments
GITSETUP_DRY_RUN="false"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dry-run)
            GITSETUP_DRY_RUN="true"
            shift # Remove argument from processing
            ;;
        *)
            # Unknown argument
            shift
            ;;
    esac
done

# Export it so sub-shells or sourced files can see it if needed
export GITSETUP_DRY_RUN

main() {
    log_info "🚀 Starting GitSetup..."

    if [[ "$GITSETUP_DRY_RUN" == "true" ]]; then
        log_warning "⚠️  DRY RUN MODE ACTIVE: No changes will be made to your system."
    fi

    # 1. Checks & Config
    if ! utils_check_dependency "git"; then log_error "Git not found." 1; fi
    if ! config_load "$ENV_FILE"; then exit 1; fi
    config_validate

    # 2. Export variables for templates
    export GITHUB_HOST GITHUB_SSH_KEY_FILE GITHUB_EMAIL
    export GITLAB_HOST GITLAB_SSH_KEY_FILE GITLAB_EMAIL
    export GIT_USER_NAME GIT_USER_EMAIL_DEFAULT GIT_CORE_EDITOR
    export SSH_DIR

    # 3. SSH Setup
    log_info "--- 🔑 SSH Setup ---"
    ssh_ensure_dir "$SSH_DIR"
    ssh_generate_key "$GITHUB_EMAIL" "$SSH_DIR/$GITHUB_SSH_KEY_FILE"
    if [[ -n "$GITLAB_EMAIL" ]]; then
        ssh_generate_key "$GITLAB_EMAIL" "$SSH_DIR/$GITLAB_SSH_KEY_FILE"
    fi
    ssh_create_config "$PROJECT_ROOT/config/ssh_config.template" "$SSH_DIR/config"

    # 4. Git Configuration
    log_info "--- 🐙 Git Configuration ---"
    git_configure_global "$PROJECT_ROOT/config/gitconfig.template"
    git_configure_ignore "$PROJECT_ROOT/config/gitignore.template"
    git_install_hooks "$PROJECT_ROOT/config/email_hook.template"

    log_success "✅ Setup complete! Open a new terminal to use updated aliases."
}

main "$@"
