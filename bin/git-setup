#!/bin/bash
# ==============================================================================
# File:        bin/git-setup
# Description: Main entry point for the Git Setup CLI.
# Author:      Noé Henchoz <henchoznoe@gmail.com>
# Date:        2025-12-21
# License:     MIT
# ==============================================================================

# Resolve paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
ENV_FILE="${GITSETUP_ENV_FILE:-$PROJECT_ROOT/.env}"
SSH_DIR="$HOME/.ssh"

# Source libraries
source "$PROJECT_ROOT/lib/logger.sh"
source "$PROJECT_ROOT/lib/utils.sh"
source "$PROJECT_ROOT/lib/config.sh"
source "$PROJECT_ROOT/lib/ssh_manager.sh"
source "$PROJECT_ROOT/lib/git_manager.sh"
source "$PROJECT_ROOT/lib/gpg_manager.sh"
source "$PROJECT_ROOT/lib/cleaner.sh"

# Parse command line arguments
GITSETUP_DRY_RUN="false"
GITSETUP_CLEAN_MODE="false"
GITSETUP_ASSUME_YES="false"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dry-run)
            GITSETUP_DRY_RUN="true"
            shift
            ;;
        --clean)
            GITSETUP_CLEAN_MODE="true"
            shift
            ;;
        -y|--yes)
            GITSETUP_ASSUME_YES="true"
            shift
            ;;
        *)
            # Unknown argument
            shift
            ;;
    esac
done

# Export states so sub-shells/functions can see them
export GITSETUP_DRY_RUN GITSETUP_ASSUME_YES

main() {
    # Fail fast on errors
    set -e
    set -o pipefail

    log_info "🚀 Starting GitSetup..."

    if [[ "$GITSETUP_DRY_RUN" == "true" ]]; then
        log_warning "⚠️  DRY RUN MODE ACTIVE: No changes will be made to your system."
    fi

    # 1. Load Configuration
    # We load config even in clean mode to know which profiles to clean
    if ! config_load "$ENV_FILE"; then exit 1; fi

    # 2. Export variables needed by modules
    export GIT_USER_NAME GIT_USER_EMAIL_DEFAULT GIT_CORE_EDITOR
    export GIT_PROFILES ENABLE_CONVENTIONAL_COMMITS
    export ENABLE_GPG_SIGNING GPG_PROGRAM
    export SSH_DIR PROJECT_ROOT

    # 3. Handle Clean Mode
    if [[ "$GITSETUP_CLEAN_MODE" == "true" ]]; then
        cleaner_run
        exit 0
    fi

    # --- SETUP MODE ---

    # 4. Dependencies & Validation
    if ! utils_check_dependency "git"; then log_error "Git not found." 1; fi
    if ! utils_check_dependency "ssh-keygen"; then log_error "ssh-keygen not found." 1; fi
    if ! utils_check_dependency "envsubst"; then log_error "envsubst (gettext) is required." 1; fi
    if [[ "${ENABLE_GPG_SIGNING}" == "true" ]]; then
        if ! utils_check_dependency "${GPG_PROGRAM:-gpg}"; then log_error "GPG program '${GPG_PROGRAM:-gpg}' not found. Try 'brew install gnupg' on macOS." 1; fi
    fi
    config_validate

    # 5. SSH Setup (Dynamic)
    log_info "--- SSH Setup ---"
    # The ssh_manager module now handles the loop over GIT_PROFILES to generate keys and config
    ssh_setup_dynamic "$SSH_DIR"

    # 6. Git Configuration
    log_info "--- Git Configuration ---"
    git_configure_global "$PROJECT_ROOT/config/gitconfig.template"
    git_configure_ignore "$PROJECT_ROOT/config/gitignore.template"
    
    # 7. GPG Setup (Run before hooks so keys are available)
    gpg_setup

    # 8. Install Hooks (Depends on GPG keys if signing is enabled)
    # Installs hooks dynamically based on GIT_PROFILES
    git_install_hooks

    log_success "✅ Setup complete! Don't forget to add your public keys to your Git providers."
}

main "$@"
